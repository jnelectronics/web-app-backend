# Backend runtime environment. Copy to .env and fill in local values.
# Never commit the real .env file (SAD §13.5 / §13.8).

ENVIRONMENT=development

# PostgreSQL connection string (Neon or local)
DATABASE_URL=postgresql+psycopg2://jn_user:jn_password@localhost:5432/jn_electronics

# Redis connection string (job queue)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Media storage
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Transactional email provider
EMAIL_PROVIDER_API_KEY=

# Payment gateway
PAYMENT_PROVIDER_API_KEY=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
