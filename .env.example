DATABASE_URL=postgresql://user:password@localhost/dbname
SECRET_KEY=replace-with-a-long-random-string
REDIS_URL=redis://localhost:6379
PESAPAL_CONSUMER_KEY=replace-with-your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=replace-with-your-pesapal-consumer-secret
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_ID=replace-after-running-register_pesapal_ipn.py
PESAPAL_CALLBACK_URL=http://localhost:3000/order-confirmation
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SENTRY_DSN=replace-with-your-sentry-project-dsn
ENVIRONMENT=development

# Frontend page the reset link in the email points to - same idea as
# PESAPAL_CALLBACK_URL above, a localhost placeholder until a real frontend
# URL exists. In production this MUST be the real frontend's actual
# reset-password page (e.g. https://yourdomain.com/reset-password) - the
# customer clicks this link straight from their inbox.
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Frontend page a staff member is sent to log in - same idea as
# PASSWORD_RESET_URL above. Filled into staff_welcome.html/staff_new_order.html/
# staff_payment_received.html's {{ login_url }}/{{ dashboard_url }} placeholders.
# In production this MUST be the real frontend's admin login page (e.g.
# https://yourdomain.com/admin/login) - if this env var is missing on
# Render, jobs.py silently falls back to this same localhost placeholder,
# which is exactly the bug that happened in production on 2026-08-22.
STAFF_DASHBOARD_URL=http://localhost:3000/admin/login

# Storefront page the "Rate your experience" link in the Order Delivered
# email points to - jobs.py's send_order_delivered_email appends
# "?token=<opaque>" itself. Same fallback-placeholder pattern as the two
# URLs above - in production this MUST be the real
# https://yourdomain.com/rate-order page (Nyson's confirmed frontend route).
RATING_URL=http://localhost:3000/rate-order

# Cloudinary - all three come from the dashboard at
# cloudinary.com/console (Product Images uploads a file there and stores
# the URL/public ID it hands back, instead of trusting a client-supplied
# URL). API_SECRET must stay server-side only - never send it to a
# frontend, unlike CLOUD_NAME which is fine to be public.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret

# Google Sign-In - from console.cloud.google.com (APIs & Services >
# Credentials). Only the Client ID is needed here - the backend only
# VERIFIES a token's signature, it never exchanges a code with Google, so
# the Client Secret Google also hands out alongside this isn't used
# anywhere in this project. This exact value is also what the frontend
# needs to initialize Google's sign-in button - same Client ID, both sides.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# Resend - replaces Gmail SMTP as the real email provider (see
# email_client.py). RESEND_FROM_EMAIL must be an address on a domain
# that's been verified with Resend (Domains > Add Domain in their
# dashboard, then add the DNS records they generate) - sending from an
# unverified domain is rejected.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Your Business Name <you@yourverifieddomain.com>