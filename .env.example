DATABASE_URL=postgresql://user:password@localhost/dbname
SECRET_KEY=replace-with-a-long-random-string
REDIS_URL=redis://localhost:6379
PESAPAL_CONSUMER_KEY=replace-with-your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=replace-with-your-pesapal-consumer-secret
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_ID=replace-after-running-register_pesapal_ipn.py
PESAPAL_CALLBACK_URL=http://localhost:3000/order-confirmation
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SENTRY_DSN=replace-with-your-sentry-project-dsn
ENVIRONMENT=development

# Gmail SMTP - GMAIL_APP_PASSWORD must be a Google "App Password" (16
# characters, generated at myaccount.google.com/apppasswords once 2-Step
# Verification is on), NOT the account's real login password - Gmail no
# longer accepts a script signing in with the actual password.
GMAIL_ADDRESS=replace-with-the-project-gmail-address
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
# Frontend page the reset link in the email points to - same idea as
# PESAPAL_CALLBACK_URL above, a localhost placeholder until a real frontend
# URL exists.
PASSWORD_RESET_URL=http://localhost:3000/reset-password